			tasks: [{
				id: "4FC5AEEF33D04DFC"
				title: "格雷电压"
				type: "checkmark"
			}]
			x: -5.5d
			y: 5.5d
		}
		{
			dependencies: ["3F2A5A509F9DF84B"]
			description: ["{将冰晶石粉放入提取机或者机械熔炼厂内可以制取六氟铝酸钠}"]
			id: "5F53673A3EA0BDA4"
